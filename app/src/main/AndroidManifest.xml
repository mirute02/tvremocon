<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Android 17 / targetSdk 37 blocks local-network traffic until the user grants this at
      runtime. INTERNET alone is not enough: both the discovery scan and every hub request
      are covered. Declared with maxSdkVersion left open so older releases simply ignore it.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TVRemocon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TVRemocon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Phase 2 harness. exported so it can be launched over adb during development;
          it takes no parameters from the intent, so nothing can be driven from outside.
        -->
        <activity
            android:name=".ui.DebugActivity"
            android:exported="true"
            android:label="Debug"
            android:theme="@style/Theme.TVRemocon" />
    </application>

</manifest>
