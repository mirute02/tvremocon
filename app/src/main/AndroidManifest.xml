<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Android 17 / targetSdk 37 blocks local-network traffic until the user grants this at
      runtime. INTERNET alone is not enough: both the discovery scan and every hub request
      are covered. Declared with maxSdkVersion left open so older releases simply ignore it.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TVRemocon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TVRemocon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Protocol harness, kept for diagnosing against a real hub. Not exported: it has a
          password field and can send any of the remote's keys, so no other app should be
          able to put it on screen. Reachable from the launcher icon and over adb.
        -->
        <activity
            android:name=".ui.DebugActivity"
            android:exported="false"
            android:label="Debug"
            android:theme="@style/Theme.TVRemocon" />

        <!-- The launcher starts this when a widget is placed, and removes the widget if it
             finishes without RESULT_OK. -->
        <activity
            android:name=".ui.WidgetSetupActivity"
            android:exported="true"
            android:theme="@style/Theme.TVRemocon">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Hub address and credentials, reachable from the app rather than only while
             placing a widget. Not exported: it has a password field. -->
        <activity
            android:name=".ui.HubSetupActivity"
            android:exported="false"
            android:label="@string/main_hub_setup"
            android:theme="@style/Theme.TVRemocon" />

        <!-- Not exported: presses arrive as explicit intents from our own PendingIntents,
             so nothing outside the app can ask it to send a key. -->
        <receiver
            android:name=".widget.TvRemoteWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tv_remote_widget_info" />
        </receiver>
    </application>

</manifest>
