<?xml version="1.0" encoding="utf-8"?>
<!--
  The stored authHash is password-equivalent for KLAP, so it must not leave the device.
  allowBackup="false" alone is not enough: some OEM builds still run device-to-device
  transfer. Exclude the whole no-backup directory (where SecretStore keeps the ciphertext)
  and the settings file from both paths explicitly.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
