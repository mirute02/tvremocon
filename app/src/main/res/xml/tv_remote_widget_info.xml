<?xml version="1.0" encoding="utf-8"?>
<!--
  Three shapes live in one widget, chosen by the size the launcher allocates: a power/channel
  strip when small, a menu-plus-number-pad when stretched sideways, the whole remote when
  made tall. An app cannot resize its own widget, so the resize range has to be wide enough
  that dragging the handles actually reaches all three.

  It starts at the landscape shape — useful immediately, and not tall enough to cover half a
  home screen where buttons get pressed by accident.

  updatePeriodMillis is 0 because nothing here changes on a timer; the widget redraws when a
  button is pressed, when it is resized, and when setup finishes.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_remote_wide"
    android:minWidth="180dp"
    android:minHeight="60dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="50dp"
    android:maxResizeWidth="640dp"
    android:maxResizeHeight="800dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="com.tvremocon.ui.WidgetSetupActivity"
    android:description="@string/widget_description"
    android:updatePeriodMillis="0" />
