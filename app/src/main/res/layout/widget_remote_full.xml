<?xml version="1.0" encoding="utf-8"?>
<!--
  Full grid: adds the number pad and HDMI inputs. Shown when the widget is large enough; resize the widget to get here.

  RemoteViews only allows a handful of layout classes, and GridLayout is one of them, so the
  button grid is expressible without a custom view. Every cell exists in the XML with a fixed
  id: RemoteViews cannot add views at runtime, it can only update the ones already here.
  Unassigned slots are made INVISIBLE rather than GONE so the grid keeps its shape.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
