<?xml version="1.0" encoding="utf-8"?>
<!--
  Full grid: the compact rows, then source selection and the 1-12 number pad. Roughly one home-screen page. Make the widget taller to reach it.

  RemoteViews cannot add views at runtime, so every cell exists here with a fixed id and is
  only updated. Three columns because that is what a remote looks like: the d-pad needs a
  centre column with one either side, and Japanese channel keys are 1-12 in a 3x4 block.

  Slot ids are shared between the two grids — slot_07 is OK in both — so resizing the widget
  never moves a button the user has already learned.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="6dp">

    <GridLayout
