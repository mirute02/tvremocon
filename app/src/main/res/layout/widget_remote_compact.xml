    <!--
      The only feedback channel a RemoteViews has. Says which of the four outcomes happened;
      "outcome unknown" is deliberately not phrased as a failure.
    -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:textSize="11sp"
        android:textColor="@color/widget_status_text"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/widget_tap_to_setup" />

