<?xml version="1.0" encoding="utf-8"?>
<!--
  Smallest strip: power and channel only. No d-pad — arrows on a small widget are both hard to hit deliberately and easy to hit by accident.

  Generated from the Kotlin layout spec so the two cannot drift. A 12-column grid
  because twelve is the smallest number divisible by both 3 and 4, which is what lets the
  number pad, the coloured row and a 6/6 left-right split all land on exact boundaries.

  RemoteViews cannot add or restyle views at runtime — it can only update ones already
  present — so every cell is written out here with its final background, and the per-button
  look (red round power key, oversized digits, circular d-pad) lives in the drawables.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="12"
        android:rowCount="1"
        android:useDefaultMargins="false">

        <Button
            android:id="@+id/compact_slot_00"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="4"
            android:layout_rowWeight="1"
            android:layout_columnSpan="4"
            android:layout_margin="2dp"
            android:background="@drawable/widget_button_power"
            android:textColor="@color/widget_power_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:singleLine="true"
            android:ellipsize="none"
            android:includeFontPadding="false"
            android:text="" />
        <Button
            android:id="@+id/compact_slot_01"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="4"
            android:layout_rowWeight="1"
            android:layout_columnSpan="4"
            android:layout_margin="2dp"
            android:background="@drawable/widget_button"
            android:textColor="@color/widget_button_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:singleLine="true"
            android:ellipsize="none"
            android:includeFontPadding="false"
            android:text="" />
        <Button
            android:id="@+id/compact_slot_02"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="4"
            android:layout_rowWeight="1"
            android:layout_columnSpan="4"
            android:layout_margin="2dp"
            android:background="@drawable/widget_button"
            android:textColor="@color/widget_button_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:singleLine="true"
            android:ellipsize="none"
            android:includeFontPadding="false"
            android:text="" />
    </GridLayout>

    <!--
      The only feedback channel a RemoteViews has. Reports which of the four outcomes
      happened; "outcome unknown" is deliberately not phrased as a failure.
    -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:textSize="10sp"
        android:textColor="@color/widget_status_text"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/widget_tap_to_setup" />

</LinearLayout>
