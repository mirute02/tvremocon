<?xml version="1.0" encoding="utf-8"?>
<!--
  Compact grid for a cover screen or a small placement: input, mute and the red power key, then volume and channel flanking the d-pad.

  Generated to mirror the physical remote's arrangement. A 12-column grid because that is
  the smallest number divisible by both 3 and 4: the number pad and most rows are three
  across, the coloured programme keys and the top utility row are four across, and every
  cell spans 3 or 4 columns so no row has to be faked with padding.

  RemoteViews cannot add or restyle views at runtime — it can only update ones already
  present — so every cell is written out here with its final background, and the per-button
  look (red round power key, oversized digits, circular d-pad) lives in the drawables.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="6dp">

