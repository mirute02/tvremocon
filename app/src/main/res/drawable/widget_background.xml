<?xml version="1.0" encoding="utf-8"?>
<!--
  A gentler radius than the buttons sit inside comfortably. At 22dp the frame's curve cut
  across the corner keys, which are themselves rounded; 14dp plus a wider padding keeps the
  two from fighting.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_background" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="#FF2B3138" />
</shape>
