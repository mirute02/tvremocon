<?xml version="1.0" encoding="utf-8"?>
<!--
  Generated. Shape carries meaning: steppers are square, digits and the power key are round.
  Every style also has an `_idle` twin, worn while the widget is resting so a stray touch is
  visibly not a button press.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_power_pressed" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_power" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="#FF7A1216" />
        </shape>
    </item>
</selector>
