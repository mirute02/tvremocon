<?xml version="1.0" encoding="utf-8"?>
<!-- The red circle at the top right. A large corner radius makes it round at whatever size
     the grid cell ends up, without needing an oval that would stretch into an ellipse. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_power_pressed" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_power" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="#FF7A1216" />
        </shape>
    </item>
</selector>
